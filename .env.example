APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

APP_LOCALE=ar
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

OPENAI_API_KEY=
OPENAI_ORGANIZATION=

# Malan CRM (Melan Internet chatbot integration)
MALAN_API_BASE_URL=https://www.malan.app
MALAN_API_KEY=
MALAN_API_TIMEOUT=15
MALAN_BANK_NAME="בנק הפועלים"
MALAN_BANK_BRANCH=665
MALAN_BANK_ACCOUNT=603495
# MALAN_VERIFIED_CONTEXT_TTL_HOURS=24
# MALAN_MEDIA_MAX_BYTES=5242880
# MALAN_MEDIA_DISK=local

# Set to false to disable SSL verification for Kaman API (local dev only, use when cURL error 60 occurs)
# KAMAN_SSL_VERIFY=false

# Kaman API host: dev → https://{restaurant}.kaman.dev/api/manager, rest → .kaman.rest
# KAMAN_API_TLD=dev

# Kaman Agents API (CEO/coworker WhatsApp staff agent)
KAMAN_AGENTS_BASE_URL=https://kamanagents-production.up.railway.app
KAMAN_AGENTS_USERNAME=
KAMAN_AGENTS_PASSWORD=
KAMAN_AGENTS_SSL_VERIFY=true

# Set to false to disable SSL verification for OpenAI API (local dev only, use when cURL error 60 occurs)
# OPENAI_SSL_VERIFY=false
# OPENAI_VERIFY_SSL=false

# Voice bot provider: fake (simulator) or telnyx
VOICE_PROVIDER=fake
VOICE_DEFAULT_CHATBOT_INSTANCE_ID=
# TTS for voice calls: elevenlabs, auto (ElevenLabs then OpenAI then Edge), openai, edge, browser
VOICE_TTS_PROVIDER=auto
ELEVENLABS_API_KEY=
ELEVENLABS_MODEL=eleven_multilingual_v2
# Premade Lily works on free API and is clearer for Arabic. Library voices (e.g. Rafoush) need a paid plan + voice id.
ELEVENLABS_VOICE_AR_WOMAN=pFZP5JQG7iQjIQuC4Bku
ELEVENLABS_VOICE_AR_MAN=
ELEVENLABS_VOICE_AR_GIRL=
ELEVENLABS_VOICE_AR_BOY=
ELEVENLABS_STABILITY=0.68
ELEVENLABS_SIMILARITY=0.85
ELEVENLABS_STYLE=0.0
ELEVENLABS_SPEED=0.92
ELEVENLABS_OPTIMIZE_LATENCY=0
VOICE_TTS_ARABIC_DIACRITIZE=false
VOICE_TTS_OPENAI_MODEL=gpt-4o-mini-tts
VOICE_TTS_OPENAI_SPEED=0.95
VOICE_TTS_OPENAI_VOICE_AR_WOMAN=coral
VOICE_PHONE_MAX_TOKENS=70
VOICE_PHONE_TEMPERATURE=0.35
VOICE_PHONE_FAST_TOOL_REPLIES=true
VOICE_PHONE_HISTORY_LIMIT=6
VOICE_PHONE_SILENCE_MS=500
VOICE_STREAMING_ENABLED=true
VOICE_LATENCY_LOG=true
VOICE_LATENCY_OVERLAY=false
# Optional: VOICE_PHONE_MODEL=gpt-4o-mini

OPENAI_REALTIME_MODEL=gpt-realtime
OPENAI_REALTIME_VOICE=marin
OPENAI_REALTIME_DEFAULT_VOICE=marin
VOICE_REALTIME_TRANSPORT=guzzle
VOICE_REALTIME_AB_CURL=false
VOICE_REALTIME_DIAGNOSE=false
VOICE_REALTIME_ENABLED=true
VOICE_REALTIME_VAD_TYPE=server_vad
VOICE_REALTIME_VAD_THRESHOLD=0.5
VOICE_REALTIME_VAD_PREFIX_MS=400
VOICE_REALTIME_VAD_SILENCE_MS=750
VOICE_REALTIME_VAD_EAGERNESS=auto

TELNYX_API_KEY=
TELNYX_PUBLIC_KEY=
TELNYX_CONNECTION_ID=
TELNYX_PHONE_NUMBER=
TELNYX_WEBHOOK_VERIFY=true
TELNYX_WEBHOOK_VERIFY_BYPASS=false
# Browser/test-chat TTS: Telnyx Bayan Arabic voices (e.g. Telnyx.Bayan.Yara)
TELNYX_TTS_VOICE_AR_WOMAN=Telnyx.Bayan.Yara
TELNYX_TTS_VOICE_AR_MAN=Telnyx.Bayan.Ahmed
TELNYX_TTS_FORMAT=mp3
TELNYX_TTS_SAMPLE_RATE=16000
