    {
      "name": "Inventory",
      "item": [
        {
          "name": "Create Inventory Item",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "var json = pm.response.json();",
                  "if (json.success && json.data && json.data.id) {",
                  "    pm.collectionVariables.set('inventory_item_id', json.data.id);",
                  "    console.log('inventory_item_id saved:', json.data.id);",
                  "}"
                ],
                "type": "text/javascript",
                "packages": {},
                "requests": {}
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name_ar\": \"دقيق\",\n  \"name_en\": \"Flour\",\n  \"name_he\": \"קמח\",\n  \"description_ar\": \"دقيق قمح أبيض\",\n  \"description_en\": \"White wheat flour\",\n  \"description_he\": \"White wheat flour\",\n  \"sku\": \"Test-001\",\n  \"unit\": \"kg\",\n  \"minimum_quantity\": 5,\n  \"track_inventory\": true,\n  \"depreciation_rate\": 0\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{base_url}}/inventory-items",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "inventory-items"
              ]
            },
            "description": "Creates a new inventory item for the current tenant.\n\nRequired fields:\n- name_ar (required)\n- unit (required) — e.g. kg, g, l, ml, piece, box, bag\n- minimum_quantity (required)\n\nOptional fields:\n- name_en, name_he\n- description_ar/en/he\n- sku (unique per tenant)\n- track_inventory (default true)\n- depreciation_rate (0-100)\n- supplier_id\n\nThe test script auto-saves the returned id to {{inventory_item_id}}."
          },
          "response": []
        },
        {
          "name": "Link Inventory Item Ingredient",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"ingredient_id\": \"{{ingredient_id}}\",\n  \"quantity_consumed\": 0.150\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{base_url}}/inventory-items/{{inventory_item_id}}/link-ingredient",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "inventory-items",
                "{{inventory_item_id}}",
                "link-ingredient"
              ]
            },
            "description": "Links an inventory item to an ingredient (component).\n\nSet {{inventory_item_id}} and {{ingredient_id}} before sending.\n\nquantity_consumed = how much of this inventory item is consumed when this ingredient is used once.\n\nIf the link already exists, quantity_consumed is updated (upsert)."
          },
          "response": []
        },
